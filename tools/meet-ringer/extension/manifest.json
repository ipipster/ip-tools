{
  "manifest_version": 3,
  "name": "Meet Ringer",
  "version": "1.1.1",
  "description": "Rings when someone joins your Google Meet meeting, before you join.",
  "permissions": [
    "alarms",
    "storage",
    "notifications",
    "offscreen",
    "tabs",
    "system.display",
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://calendar.google.com/*",
    "https://meet.google.com/*",
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Meet Ringer",
    "default_icon": {
      "128": "icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*"
      ],
      "js": [
        "block-media.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://meet.google.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://script.googleusercontent.com/*",
        "https://script.google.com/*"
      ],
      "js": [
        "feed.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "icons": {
    "128": "icon128.png"
  },
  "key": ""
}